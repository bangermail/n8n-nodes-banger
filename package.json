{
  "name": "n8n-nodes-banger",
  "version": "0.1.0",
  "description": "Banger is company email your AI runs. Send Product email, manage contacts and lists, run Journeys and react to Banger events in n8n.",
  "license": "MIT",
  "homepage": "https://github.com/bangermail/n8n-nodes-banger#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "banger",
    "bangermail",
    "email",
    "transactional-email",
    "email-marketing",
    "journeys"
  ],
  "author": {
    "name": "BangerMail Inc.",
    "email": "hello@team.bangermail.com",
    "url": "https://bangermail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangermail/n8n-nodes-banger.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/*.js.map"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/BangerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Banger/Banger.node.js",
      "dist/nodes/BangerTrigger/BangerTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.51.3",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/bangermail/n8n-nodes-banger/issues"
  }
}
